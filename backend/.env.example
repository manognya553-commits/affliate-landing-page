# ==============================================================================
# sBLOOM Backend Environment Configuration (.env)
# ==============================================================================

# ENVIRONMENT: 'development' or 'production'
# In development, interactive API docs are available at http://localhost:8000/docs
# In production, docs are turned off for security.
ENVIRONMENT=development

# SUPABASE POSTGRESQL DATABASE URL (Session Pooler)
# IMPORTANT:
# 1. Use the Session Pooler connection string on port 5432 (NEVER use port 6543 / transaction pooler).
# 2. Driver MUST be 'postgresql+psycopg://'.
# 3. Append '?sslmode=require'.
# 4. If your database password contains special characters (like @, #, $, %, etc.), URL-encode them.
# Example:
# postgresql+psycopg://postgres.xaywpovqmgpceyeoxozq:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# JWT SECRET KEY
# Used to sign access tokens. Generate a secure random string (e.g. run: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# CLIENT APPLICATION URL
# The frontend origin for CORS and CSRF validation (e.g. http://localhost:5173 for local frontend)
CLIENT_URL=http://localhost:5173

# EMAIL CONFIGURATION (SMTP)
# While email credentials are not configured, verification and password reset links
# will be printed directly in the backend terminal console during development.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=no-reply@sbloom.in
SMTP_USE_TLS=true
